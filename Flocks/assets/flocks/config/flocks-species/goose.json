{
	// Greylag goose. Our own model (tools/make_greylag.py). Passes over in V's, and lands on lakes as flocks:greylag
	// (its behaviour tuning and sounds are in entities/greylag.json). Fields: see Flocks/Species.cs.
	code: "goose",
	name: "greylag geese",
	shapes: [
		{ name: "greylag", shape: "flocks:shapes/entity/bird/greylag.json", flap: "fly-flap", soar: "fly-soar" }
	],
	// drawn at the landed entity's size (client.size 0.65: 1.7 blocks across; a real greylag is 1.5-1.8 m)
	sizeFromEntity: "flocks:greylag",
	// geese flap steadily with short glides
	speedMin: 16, speedMax: 21,
	flapSeconds: 0.5, soarSeconds: 2, blendSeconds: 0.35,
	flapBeatsMin: 8, flapBeatsMax: 16, soarLoopsMin: 1, soarLoopsMax: 1,
	// late in autumn and early in spring, mornings and late afternoons, in V's of 7-25; resident from springStart to autumnStart
	springStart: 0.03, springEnd: 0.22, autumnStart: 0.62, autumnEnd: 0.85,
	hours: [6.5, 10, 15.5, 19],
	maxFlocksPerDay: 3, countMin: 7, countMax: 25,
	callSound: "goose/honk", callVariants: 6, callGapMin: 10, callGapMax: 25,
	landedEntity: "flocks:greylag",
	landingMin: 7, landingMax: 12
}
