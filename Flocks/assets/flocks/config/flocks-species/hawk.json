// Hawk / buzzard. Vanilla's unused hawk shape, with sparrow and chicken fallbacks in case an update removes it.
// Passes over only, silent. Fields: see Flocks/Species.cs.
{
	code: "hawk",
	name: "hawks",
	shapes: [
		{ name: "hawk", shape: "game:shapes/entity/animal/bird/raptor/hawk/hawk.json", flap: "fly-flap", soar: "fly-soar" },
		// the sparrow shape points at bird/sparrow/..., but the file ships in bird/passerine/
		{ name: "treesparrow", shape: "game:shapes/entity/animal/bird/passerine/treesparrow-adult-male.json", flap: "flap", soar: "soar",
		  texOverride: "entity/animal/bird/passerine/treesparrow-adult-male" },
		{ name: "chicken", shape: "game:shapes/entity/animal/bird/chicken/chicken-hen.json", flap: "fly", soar: "fly" }
	],
	// buzzard-sized: about 1.2 m wingspan (also applied to the fallback shapes)
	wingspan: 1.2,
	// raptors ride midday thermals; the big passage is autumn, spring is lighter. Loose groups of 3-10.
	springStart: 0.08, springEnd: 0.22, springWeight: 0.5, autumnStart: 0.55, autumnEnd: 0.72,
	hours: [10, 15],
	maxFlocksPerDay: 2, countMin: 3, countMax: 10,
	loose: true
}
