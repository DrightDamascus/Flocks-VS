{
	code: "greylag",
	class: "EntityAgent",
	tags: ["animal", "huntable", "adult", "habitat-water"],
	// scaled with client.size 0.98
	hitboxSize: { x: 1.0, y: 0.9 },
	deadHitboxSize: { x: 1.0, y: 0.5 },
	eyeHeight: 0.8,
	fallDamageMultiplier: 0.5,
	drops: [],
	attributes: {
		handbook: { exclude: true }
	},
	client: {
		renderer: "Shape",
		shape: { base: "flocks:entity/bird/greylag" },
		textures: { "greylag": { base: "flocks:entity/bird/greylag" } },
		// 2.6-block wingspan: half again a real greylag's 1.5-1.8 m, so it reads as a goose next to the game's animals.
		// The sky geese read this too, so both always match
		size: 0.98,
		behaviors: [
			{ code: "repulseagents" },
			{ code: "controlledphysics", stepHeight: 0.6 },
			{ code: "floatupwhenstuck", onlyWhenDead: true },
			{ code: "interpolateposition" },
			{ code: "harvestable" }
		],
		animations: [
			{ code: "swim", animation: "swim", blendMode: "Average", easeInSpeed: 4, easeOutSpeed: 4, triggeredBy: { defaultAnim: true } },
			{ code: "idle-stand", animation: "idle-stand", blendMode: "Average", easeInSpeed: 4, easeOutSpeed: 4 },
			{ code: "walk", animation: "walk", blendMode: "Average", easeInSpeed: 4, easeOutSpeed: 4 },
			{ code: "fly-flap", animation: "fly-flap", animationSpeed: 1.6, blendMode: "Average", weight: 10, easeInSpeed: 8, easeOutSpeed: 8 },
			{ code: "fly-soar", animation: "fly-soar", blendMode: "Average", weight: 10, easeInSpeed: 4, easeOutSpeed: 4 },
			// the hurried run and first wingbeats off the water, and the flare with feet forward when coming down
			{ code: "takeoff", animation: "takeoff", animationSpeed: 2.6, blendMode: "Average", weight: 10, easeInSpeed: 12, easeOutSpeed: 6 },
			{ code: "land", animation: "land", animationSpeed: 1.3, blendMode: "Average", weight: 10, easeInSpeed: 5, easeOutSpeed: 4 },
			{ code: "die", animation: "death", animationSpeed: 1.25, weight: 10, blendMode: "Average", triggeredBy: { onControls: ["dead"] } }
		]
	},
	server: {
		behaviors: [
			{ code: "repulseagents" },
			{ code: "controlledphysics", stepHeight: 0.6 },
			// before "health": it zeroes spear and melee damage before health applies it
			{ code: "flocks.waterfowl", species: "goose", fleeRange: 14, takeoffRange: 7, lifeHours: 6, sink: 0.22, cruiseSpeedMin: 11, cruiseSpeedMax: 13.5,
			  takeoffWingsChance: 0.6, takeoffCallChance: 0.4 },
			{ code: "health", currenthealth: 4, maxhealth: 4 },
			{ code: "deaddecay", hoursToDecay: 48, decayedBlock: "game:carcass-tiny" },
			{ code: "harvestable", drops: [
				{ type: "item", code: "game:poultry-raw", quantity: { avg: 3.25, var: 0.5 } },
				{ type: "item", code: "game:feather", quantity: { avg: 14, var: 2 } }
			] },
			{ code: "floatupwhenstuck", onlyWhenDead: true }
		],
		// Vanilla spawning, modelled on freshwater fish. tryOnlySurface places the group just above the worldgen terrain
		// height, i.e. on the lake bed inside the water; the geese float up. No light limit: water dims sunlight with
		// depth, and tryOnlySurface already keeps them out of caves. Season, lake size, shore distance and crowding are
		// vetoed in Residents.cs (after vanilla has found the spots).
		spawnconditions: {
			worldgen: {
				TriesPerChunk: { avg: 0.03, var: 0 },
				tryOnlySurface: true,
				groupSize: { dist: "verynarrowgaussian", avg: 9.5, var: 2.5 },
				insideBlockCodes: ["game:water-still-7"],
				minTemp: -8,
				maxTemp: 26,
				minRain: 0.3
			},
			runtime: {
				group: "passive",
				MinDistanceToPlayer: 32,
				// Rolled once per entity type every 0.5 s to decide whether geese are considered at all that round (not
				// per chunk). 0.0003 meant about once every 28 minutes, so they almost never appeared; 0.01 is ~50 s.
				chance: 0.01,
				// all loaded geese on the server (scaled up for extra players), not per area: about two groups of 7-12
				maxQuantity: 24,
				tryOnlySurface: true,
				groupSize: { dist: "verynarrowgaussian", avg: 9.5, var: 2.5 },
				insideBlockCodes: ["game:water-still-7"],
				minTemp: -8,
				maxTemp: 26,
				minRain: 0.3
			}
		}
	},
	sounds: {
		hurt: "flocks:goose/hurt",
		death: "flocks:goose/death",
		idle: { path: "flocks:goose/honk*", pitch: { avg: 1, var: 0.15 }, range: 32 },
		// played by flocks.waterfowl: a splash as each bird runs off the water, wingbeats and an alarm call from some
		// of them (takeoffWingsChance / takeoffCallChance), and a splash as each comes down
		takeoffsplash: { path: "game:environment/smallsplash", pitch: { avg: 1, var: 0.1 }, range: 24, volume: { avg: 0.5 } },
		takeoffwings: { path: "flocks:wings/flap*", pitch: { avg: 1, var: 0.1 }, range: 32, volume: { avg: 0.9 } },
		takeoffcall: { path: "flocks:goose/flight*", pitch: { avg: 1, var: 0.1 }, range: 48, volume: { avg: 0.7 } },
		landsplash: { path: "game:environment/mediumsplash", pitch: { avg: 1, var: 0.1 }, range: 24, volume: { avg: 0.45 } }
	},
	// vanilla's idle sound roll (chickens use 0.05); geese on the water call now and then
	idleSoundChance: 0.02
}
