<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Flocks</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VINTAGE_STORY Condition="'$(VINTAGE_STORY)' == ''">$(USERPROFILE)\agent-tools\vsref1227</VINTAGE_STORY>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <!-- the game's own essentials mod: POIRegistry, which crows search for farmland (IAnimalFoodSource) -->
    <Reference Include="VSEssentials"><HintPath>$(VINTAGE_STORY)\Mods\VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VINTAGE_STORY)\Lib\protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VINTAGE_STORY)\Lib\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

