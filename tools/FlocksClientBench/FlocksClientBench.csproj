<Project Sdk="Microsoft.NET.Sdk">
  <!-- Frame-time benchmark for Flocks in the real game client: loaded only by tools/run_client_bench.ps1, never shipped.
       Finds Flocks by reflection, so it runs with any Flocks version or none (the comparison run). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FlocksClientBench</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VINTAGE_STORY Condition="'$(VINTAGE_STORY)' == ''">$(USERPROFILE)\agent-tools\vsref1227</VINTAGE_STORY>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VINTAGE_STORY)\Lib\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
